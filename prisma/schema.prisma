generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppInstallation {
  id              String   @id
  initializedAt   DateTime @default(now())
  initializedById String?
}

model User {
  id                  String                   @id @default(cuid())
  email               String                   @unique
  username            String?                  @unique
  name                String?
  passwordHash        String?
  role                String                   @default("USER")
  active              Boolean                  @default(true)
  mustChangePassword  Boolean                  @default(false)
  passwordChangedAt   DateTime?
  emailVerified       DateTime?
  roles               UserRole[]
  permissionOverrides UserPermissionOverride[]
  auditActions        AuditLog[]               @relation("AuditActor")
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
}

model Permission {
  id            String                   @id @default(cuid())
  name          String
  slug          String                   @unique
  description   String
  system        Boolean                  @default(true)
  roles         RolePermission[]
  userOverrides UserPermissionOverride[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
}

model Role {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String
  system      Boolean          @default(false)
  assignable  Boolean          @default(true)
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserPermissionOverride {
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  allowed      Boolean
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@id([userId, permissionId])
  @@index([permissionId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  targetType  String
  targetId    String?
  metadata    String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  logoUrl      String?
  primaryColor String   @default("#14f1cc")
  accentColor  String   @default("#14f1cc")
  timezone     String   @default("America/Chicago")
  domain       String?
  events       Event[]
  settings     Setting?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Event {
  id                        String        @id @default(cuid())
  organizationId            String
  organization              Organization  @relation(fields: [organizationId], references: [id])
  name                      String
  description               String
  venue                     String
  address                   String
  startsAt                  DateTime
  endsAt                    DateTime
  capacity                  Int
  photoUrl                  String?
  bannerImageUrl            String?
  logoUrl                   String?
  allergenOptions           String?
  organizer                 String
  contactEmail              String
  contactPhone              String?
  passTheme                 String        @default("minimal")
  status                    String        @default("DRAFT")
  registrationEnabled       Boolean       @default(true)
  qrPassesEnabled           Boolean       @default(true)
  emailConfirmationsEnabled Boolean       @default(true)
  waitlistEnabled           Boolean       @default(false)
  registrationDeadline      DateTime?
  attendees                 Attendee[]
  emailLogs                 EmailLog[]
  rafflePrizes              RafflePrize[]
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
}

model Attendee {
  id                String        @id @default(cuid())
  eventId           String
  event             Event         @relation(fields: [eventId], references: [id])
  firstName         String
  lastName          String
  email             String
  phone             String?
  company           String?
  birthDate         DateTime?
  selectedAllergens String?
  plusOneEnabled    Boolean       @default(false)
  plusOneFirstName  String?
  plusOneLastName   String?
  plusOneBirthDate  DateTime?
  plusOneAllergens  String?
  under21           Boolean       @default(false)
  plusOneUnder21    Boolean       @default(false)
  ticketTier        String        @default("General")
  seat              String?
  vip               Boolean       @default(false)
  raffleTickets     Int           @default(0)
  notes             String?
  customAnswers     String?
  status            String        @default("REGISTERED")
  pass              Pass?
  checkIns          CheckIn[]
  raffleEntries     RaffleEntry[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([eventId, email])
  @@index([eventId, status])
}

model Pass {
  id           String   @id @default(cuid())
  attendeeId   String   @unique
  attendee     Attendee @relation(fields: [attendeeId], references: [id])
  fallbackCode String   @unique
  qrPayload    String
  tokenHash    String
  pdfUrl       String?
  createdAt    DateTime @default(now())
}

model CheckIn {
  id          String   @id @default(cuid())
  attendeeId  String
  attendee    Attendee @relation(fields: [attendeeId], references: [id])
  scannedById String?
  scannedAt   DateTime @default(now())
  duplicate   Boolean  @default(false)
  rawPayload  String?
}

model EmailLog {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id])
  attendeeId String?
  recipient  String
  type       String
  subject    String
  providerId String?
  status     String   @default("QUEUED")
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model RafflePrize {
  id               String        @id @default(cuid())
  eventId          String
  event            Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  value            String?
  imageUrl         String?
  status           String        @default("ACTIVE")
  winnerName       String?
  winnerAttendeeId String?
  drawnAt          DateTime?
  rerollCount      Int           @default(0)
  entries          RaffleEntry[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([eventId, status])
}

model RaffleEntry {
  id          String      @id @default(cuid())
  prizeId     String
  prize       RafflePrize @relation(fields: [prizeId], references: [id], onDelete: Cascade)
  attendeeId  String
  attendee    Attendee    @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  ticketCount Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([prizeId, attendeeId])
  @@index([attendeeId])
}

model Setting {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  organization    Organization @relation(fields: [organizationId], references: [id])
  smtpHost        String?
  smtpPort        Int?
  smtpUser        String?
  smtpFrom        String?
  defaultTimezone String       @default("America/Chicago")
  apiKeyHash      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}
